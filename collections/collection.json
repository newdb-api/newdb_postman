{
  "info": {
    "_postman_id": "7b8f9e12-3a45-4c67-8d90-1e2f3a4b5c6d",
    "name": "NEWDB (DaaS platform)",
    "description": "Официальная Postman-коллекция NEWDB REST API — универсального шлюза для проверки физических лиц, юридических лиц, иностранных граждан, залогов, недвижимости и судебных дел по официальным государственным реестрам РФ (ФНС, ФССП, МВД, Федресурс, КАД Арбитр, ЕГРЮЛ, ЕГРИП, Нотариат/Залоги, ГАС Правосудие, РКЛ).\n\nДокументация: https://newdb.net/docs\nБазовый URL: {{base_url}} (https://api.newdb.net/v2)\nАутентификация: заголовок X-API-KEY: {{api_token}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{api_token}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-API-KEY",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.newdb.net/v2",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "your_api_token_here",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "00000000-0000-4000-8000-000000000001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Service & Auth",
      "description": "Базовые системные методы: проверка баланса токена, отправка асинхронных задач и получение результатов по requestId.",
      "item": [
        {
          "name": "Get Token Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/balance",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "balance"
              ]
            },
            "description": "Проверка текущего остатка оплаченных запросов по API-токену."
          },
          "response": []
        },
        {
          "name": "Get Task Status by RequestId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}",
              "host": [
                "{{base_url}}"
              ],
              "path": []
            },
            "description": "Получение результата ранее отправленной задачи по ее requestId."
          },
          "response": []
        }
      ]
    },
