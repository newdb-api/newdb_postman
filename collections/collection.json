              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.requestId) {",
                  "    pm.collectionVariables.set('request_id', data.requestId);",
                  "    console.log('Saved requestId:', data.requestId);",
                  "}"
